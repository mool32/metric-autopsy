ID","value":"0000-0002-2754-9971"},{"type":"ORCID","value":"0000-0002-3457-5967"},{"type":"ORCID","value":"0000-0002-3588-3080"},{"type":"ORCID","value":"0000-0002-3812-6165"},{"type":"ORCID","value":"0000-0002-4691-556X"},{"type":"ORCID","value":"0000-0002-4959-9590"},{"type":"ORCID","value":"0000-0002-7227-4276"},{"type":"ORCID","value":"0000-0002-7542-1577"},{"type":"ORCID","value":"0000-0002-7818-1388"},{"type":"ORCID","value":"0000-0002-8316-4531"},{"type":"ORCID","value":"0000-0002-8546-2364"},{"type":"ORCID","value":"0000-0003-1098-9046"},{"type":"ORCID","value":"0000-0003-1596-207X"},{"type":"ORCID","value":"0000-0003-2798-6220"},{"type":"ORCID","value":"0000-0003-3494-5697"},{"type":"ORCID","value":"0000-0003-3771-6662"},{"type":"ORCID","value":"0000-0003-4031-0954"},{"type":"ORCID","value":"0009-0002-9849-2711"},{"type":"ORCID","value":"0009-0008-8793-9884"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"issue":"7817","volume":"583","journalIssueId":2980483,"dateOfPublication":"2020 Jul","monthOfPublication":7,"yearOfPublication":2020,"journal":{"medlineAbbreviation":"Nature","title":"Nature","essn":"1476-4687","issn":"0028-0836","nlmid":"0410462","isoabbreviation":"Nature"},"printPublicationDate":"2020-07-01"},"pubYear":"2020","pageInfo":"590-595","abstractText":"Ageing is characterized by a progressive loss of physiological integrity, leading to impaired function and increased vulnerability to death<sup>1</sup>. Despite rapid advances over recent years, many of the molecular and cellular processes that underlie the progressive loss of healthy physiology are poorly understood<sup>2</sup>. To gain a better insight into these processes, here we generate a single-cell transcriptomic atlas across the lifespan of Mus musculus that includes data from 23 tissues and organs. We found cell-specific changes occurring across multiple cell types and organs, as well as age-related changes in the cellular composition of different organs. Using single-cell transcriptomic data, we assessed cell-type-specific manifestations of different hallmarks of ageing-such as senescence<sup>3</sup>, genomic instability<sup>4</sup> and changes in the immune system<sup>2</sup>. This transcriptomic atlas-which we denote Tabula Muris Senis, or 'Mouse Ageing Cell Atlas'-provides molecular information about how the most important hallmarks of ageing are reflected in a broad range of tissues and cell types.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["Research Support, Non-U.S. Gov't","research-article","Research Support, U.S. Gov't, Non-P.H.S.","Journal Article","Research Support, N.I.H., Extramural"]},"grantsList":{"grant":[{"agency":"BLRD VA","acronym":"BX","grantId":"IK6 BX004599","orderIn":0},{"agency":"NIA NIH HHS","acronym":"AG","grantId":"DP1 AG053015","orderIn":0},{"agency":"NHLBI NIH HHS","acronym":"HL","grantId":"K99 HL127267","orderIn":0},{"agency":"NIDDK NIH HHS","acronym":"DK","grantId":"P30 DK026743","orderIn":0},{"agency":"NHLBI NIH HHS","acronym":"HL","grantId":"R00 HL127267","orderIn":0},{"agency":"NIDDK NIH HHS","acronym":"DK","grantId":"K08 DK101603","orderIn":0},{"agency":"NIDCD NIH HHS","acronym":"DC","grantId":"R01 DC016892","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Liver","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"CY","qualifierName":"cytology"},{"majorTopic_YN":"N","abbreviation":"ME","qualifierName":"metabolism"}]}},{"majorTopic_YN":"N","descriptorName":"T-Lymphocytes","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"CY","qualifierName":"cytology"},{"majorTopic_YN":"N","abbreviation":"ME","qualifierName":"metabolism"}]}},{"majorTopic_YN":"N","descriptorName":"Animals"},{"majorTopic_YN":"N","descriptorName":"Mice"},{"majorTopic_YN":"N","descriptorName":"Genomic Instability"},{"majorTopic_YN":"N","descriptorName":"DNA Mutatio